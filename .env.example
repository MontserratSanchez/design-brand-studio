# Solo nombres. Los valores reales viven en las credenciales de n8n y en los secretos de GitHub, nunca en el repositorio.
TELEGRAM_BOT_TOKEN=          # n8n → credencial «DBS Telegram bot»
ANTHROPIC_API_KEY=           # n8n → credencial «DBS Anthropic» (Header Auth x-api-key)
DBS_VOZ_SECRETO=             # n8n → credencial «DBS Voz secreto» y secreto de la herramienta en ElevenLabs
GITHUB_TOKEN_EXPORTACION=    # n8n → credencial «DBS GitHub» (permiso de contenido solo en este repositorio)
ELEVENLABS_AGENT_ID=         # público: va en web/index.html (AGENTE_VOZ_ID). No es una credencial.
N8N_URL_VOZ=                 # Production URL del webhook de W4 (se configura en ElevenLabs, no en el HTML)
