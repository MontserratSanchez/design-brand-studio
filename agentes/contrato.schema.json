{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design-brand-studio/contrato/v1",
  "title": "Contrato común de entrada y salida entre orquestador y agentes",
  "$defs": {
    "caso_id": { "type": "string", "pattern": "^DBS-[0-9]{8}-[A-Z0-9]{4}$" },
    "agente": { "enum": ["orquestador", "a1_recepcion", "a2_catalogo", "a3_propuesta", "a4_revisor"] },
    "entrada": {
      "type": "object",
      "required": ["caso_id", "canal", "usuario", "objetivo", "datos", "modo", "limite_costo_usd", "iteracion"],
      "additionalProperties": false,
      "properties": {
        "caso_id": { "$ref": "#/$defs/caso_id" },
        "canal": { "enum": ["telegram", "voz"] },
        "usuario": { "type": "string", "description": "Seudónimo, nunca nombre real ni ID de Telegram", "pattern": "^U-[A-Z0-9]{6}$" },
        "objetivo": { "type": "string", "maxLength": 200 },
        "datos": { "type": "object" },
        "modo": { "const": "SIMULADO" },
        "limite_costo_usd": { "type": "number", "exclusiveMinimum": 0 },
        "iteracion": { "type": "integer", "minimum": 1, "maximum": 3 }
      }
    },
    "salida": {
      "type": "object",
      "required": ["caso_id", "agente", "estado", "resultado", "fuentes", "advertencias", "duracion_ms", "consumo_ref"],
      "additionalProperties": false,
      "properties": {
        "caso_id": { "$ref": "#/$defs/caso_id" },
        "agente": { "$ref": "#/$defs/agente" },
        "estado": { "enum": ["ok", "requiere_datos", "insuficiente", "devuelto", "aprobado", "rechazado", "error"] },
        "resultado": { "type": "object" },
        "fuentes": { "type": "array", "items": { "type": "string" } },
        "advertencias": { "type": "array", "items": { "type": "string" } },
        "duracion_ms": { "type": "integer", "minimum": 0 },
        "consumo_ref": { "type": ["string", "null"], "description": "llamada_id en la tabla costos; null si el paso no usó modelo" }
      }
    }
  }
}
